{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostContractV3",
  "description": "Aggregate used only to export the new authoritative Host contract.\nExisting V2 consumers and registered commands remain supported unchanged.",
  "type": "object",
  "properties": {
    "native_extension": {
      "$ref": "#/$defs/NativeExtensionV1"
    },
    "plugin": {
      "$ref": "#/$defs/PluginViewV2"
    },
    "plugin_configuration": {
      "$ref": "#/$defs/PluginConfigurationV1"
    },
    "previous": {
      "$ref": "#/$defs/HostContractV2"
    },
    "set_plugin_configuration_request": {
      "$ref": "#/$defs/SetPluginConfigurationRequestV1"
    },
    "signed_marketplace": {
      "$ref": "#/$defs/SignedMarketplaceV1"
    },
    "standard_manifest": {
      "$ref": "#/$defs/AgentPluginsManifestV1"
    },
    "verify_plugin_connection_request": {
      "$ref": "#/$defs/VerifyPluginConnectionRequestV1"
    }
  },
  "required": [
    "previous",
    "standard_manifest",
    "native_extension",
    "plugin_configuration",
    "plugin",
    "verify_plugin_connection_request",
    "set_plugin_configuration_request",
    "signed_marketplace"
  ],
  "$defs": {
    "AdapterV1": {
      "type": "object",
      "properties": {
        "distribution": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "distribution",
        "version"
      ]
    },
    "AgentPluginsManifestV1": {
      "$id": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Agent Plugins Manifest",
      "description": "Machine-readable schema for plugin.json in Agent Plugins 1.0.0. The Agent Plugins specification defines additional semantic and operational requirements.",
      "type": "object",
      "properties": {
        "$schema": {
          "description": "Canonical identifier of the plugin manifest schema for the Agent Plugins version targeted by this document.",
          "const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
        },
        "author": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "description": "Client-specific manifest data keyed by reverse-domain extension namespace. Agent Plugins assigns no semantics to namespace object contents.",
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "homepage": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "name": {
          "description": "Human-readable plugin name.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "repository": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "$schema",
        "name"
      ]
    },
    "ArchiveV1": {
      "type": "object",
      "properties": {
        "byteLength": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "byteLength",
        "sha256"
      ]
    },
    "Compatibility": {
      "type": "string",
      "enum": [
        "compatible",
        "unsupportedBuild",
        "invalidInstallation"
      ]
    },
    "ComponentV1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "ConnectionStateV1": {
      "type": "string",
      "enum": [
        "waitingForRhino",
        "connecting",
        "connected",
        "reconnecting",
        "error"
      ]
    },
    "ConnectorRequest": {
      "type": "object",
      "properties": {
        "connectorInstanceId": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "connectorInstanceId",
        "expectedRevision"
      ]
    },
    "ContractRange": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "DetectedSoftwareV1": {
      "type": "object",
      "properties": {
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SoftwareIdentityV1"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "identities"
      ]
    },
    "HostContractV2": {
      "description": "Aggregate used only to export the current Host IPC JSON Schema.",
      "type": "object",
      "properties": {
        "connector_request": {
          "$ref": "#/$defs/ConnectorRequest"
        },
        "install_request": {
          "$ref": "#/$defs/InstallRequest"
        },
        "lifecycle_hint": {
          "$ref": "#/$defs/PluginLifecycleHintV1"
        },
        "operation": {
          "$ref": "#/$defs/PluginOperationV2"
        },
        "plugin": {
          "$ref": "#/$defs/PluginViewV1"
        },
        "refresh_plugin_request": {
          "$ref": "#/$defs/RefreshPluginRequestV1"
        },
        "retry_plugin_request": {
          "$ref": "#/$defs/RetryPluginRequestV1"
        },
        "secret_request": {
          "$ref": "#/$defs/SecretRequest"
        },
        "stop_request": {
          "$ref": "#/$defs/StopRequest"
        },
        "uninstall_request": {
          "$ref": "#/$defs/UninstallRequest"
        }
      },
      "required": [
        "install_request",
        "refresh_plugin_request",
        "retry_plugin_request",
        "connector_request",
        "secret_request",
        "stop_request",
        "uninstall_request",
        "plugin",
        "operation",
        "lifecycle_hint"
      ]
    },
    "InstallRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "expectedRevision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "packageId": {
              "type": "string",
              "const": "dlubal-rfem"
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            },
            "softwareIdentity": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "packageId",
            "requestId",
            "expectedRevision",
            "softwareIdentity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expectedRevision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "packageId": {
              "type": "string",
              "const": "rhino"
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "packageId",
            "requestId",
            "expectedRevision"
          ]
        }
      ]
    },
    "McpTransportV1": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "transport",
        "path"
      ]
    },
    "NativeExtensionV1": {
      "description": "Host extension, never an Agent Plugins standard root field.",
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterV1"
        },
        "agentContract": {
          "$ref": "#/$defs/ContractRange"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentV1"
          }
        },
        "configurationSchemaPath": {
          "type": "string"
        },
        "configurationSchemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "entrypoint": {
          "type": "string"
        },
        "hostContract": {
          "$ref": "#/$defs/ContractRange"
        },
        "mcp": {
          "$ref": "#/$defs/McpTransportV1"
        },
        "module": {
          "type": "string"
        },
        "native": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePackageV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "$ref": "#/$defs/PlatformV1"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        },
        "routine": {
          "$ref": "#/$defs/NativeRoutineV1"
        },
        "secretSlots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretSlotV1"
          }
        },
        "software": {
          "$ref": "#/$defs/SoftwareRequirementV1"
        },
        "startupEnvelopeVersion": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2,
          "minimum": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "platform",
        "hostContract",
        "agentContract",
        "startupEnvelopeVersion",
        "routine",
        "entrypoint",
        "module",
        "components",
        "mcp",
        "software",
        "adapter",
        "configurationSchemaVersion",
        "configurationSchemaPath",
        "secretSlots"
      ]
    },
    "NativePackageV1": {
      "type": "object",
      "properties": {
        "capabilityDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractDigest": {
          "type": "string"
        },
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "packageId": {
          "type": "string"
        },
        "pluginId": {
          "type": "string",
          "format": "uuid"
        },
        "relativePath": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "relativePath",
        "sha256",
        "contractVersion",
        "contractDigest",
        "pluginId"
      ]
    },
    "NativeRoutineKindV1": {
      "type": "string",
      "enum": [
        "managed-provider",
        "rhino-yak-bridge"
      ]
    },
    "NativeRoutineV1": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/NativeRoutineKindV1"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "version"
      ]
    },
    "PlatformV1": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string"
        },
        "os": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ]
    },
    "PluginAttachmentStateV1": {
      "type": "string",
      "enum": [
        "detached",
        "discovering",
        "attached",
        "error"
      ]
    },
    "PluginConfigurationV1": {
      "description": "Ordinary values are accepted only after validation against the derived schema.",
      "type": "object",
      "properties": {
        "configurationSchema": true,
        "ordinarySchema": true,
        "packageId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secretSlots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretSlotStatusV1"
          }
        },
        "values": true
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packageId",
        "revision",
        "configurationSchema",
        "ordinarySchema",
        "values",
        "secretSlots"
      ]
    },
    "PluginConnectionSettingsV1": {
      "type": "object",
      "properties": {
        "secretSlots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretSlotStatusV1"
          }
        },
        "state": {
          "$ref": "#/$defs/PluginConnectionStateV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "secretSlots"
      ]
    },
    "PluginConnectionStateV1": {
      "type": "string",
      "enum": [
        "missingSecret",
        "storedUnverified",
        "softwareUnavailable",
        "unsupportedSoftwareVersion",
        "verifying",
        "authenticationFailed",
        "authorizationRestricted",
        "quotaRestricted",
        "apiAccessRestricted",
        "connected"
      ]
    },
    "PluginDetailV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "attachmentState": {
              "$ref": "#/$defs/PluginAttachmentStateV1"
            },
            "credentialConfigured": {
              "type": "boolean"
            },
            "detectedSoftware": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DetectedSoftwareV1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "installationState": {
              "$ref": "#/$defs/PluginInstallationStateV1"
            },
            "kind": {
              "type": "string",
              "const": "dlubalRfem"
            },
            "processState": {
              "$ref": "#/$defs/PluginProcessStateV1"
            },
            "secretRevision": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "softwareState": {
              "$ref": "#/$defs/PluginSoftwareStateV1"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "softwareState",
            "installationState",
            "processState",
            "attachmentState",
            "credentialConfigured"
          ]
        },
        {
          "type": "object",
          "properties": {
            "activationRequired": {
              "type": "boolean"
            },
            "attachmentState": {
              "$ref": "#/$defs/PluginAttachmentStateV1"
            },
            "connectionState": {
              "$ref": "#/$defs/ConnectionStateV1"
            },
            "installationState": {
              "$ref": "#/$defs/PluginInstallationStateV1"
            },
            "kind": {
              "type": "string",
              "const": "rhino"
            },
            "nativePackageVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "providerState": {
              "$ref": "#/$defs/PluginProcessStateV1"
            },
            "ready": {
              "type": "boolean"
            },
            "softwareState": {
              "$ref": "#/$defs/PluginSoftwareStateV1"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "softwareState",
            "installationState",
            "connectionState",
            "providerState",
            "attachmentState",
            "activationRequired",
            "ready"
          ]
        }
      ]
    },
    "PluginError": {
      "type": "string",
      "enum": [
        "revisionConflict",
        "missingSecret",
        "secretStoreUnavailable",
        "secretStateUnknown",
        "invalidContract",
        "untrustedRelease",
        "releaseExpired",
        "releaseRevoked",
        "downgradeRejected",
        "artifactMismatch",
        "unsafeArchive",
        "tampered",
        "storageUnavailable",
        "downloadFailed",
        "downloadRejected",
        "operationCancelled",
        "operationInterrupted",
        "hostAlreadyRunning",
        "providerStartFailed",
        "providerExited",
        "portInUse",
        "pluginBusy",
        "agentUnavailable",
        "attachmentRejected",
        "catalogUnavailable",
        "unsupportedOperation",
        "unsupportedRhinoVersion",
        "yakUnavailable",
        "nativePackageFailed",
        "bridgeRejected",
        "bridgeIncompatible",
        "toolCatalogMismatch",
        "resultUnknown"
      ]
    },
    "PluginIconV1": {
      "type": "string",
      "enum": [
        "dlubalRfem",
        "rhino"
      ]
    },
    "PluginInstallationStateV1": {
      "type": "string",
      "enum": [
        "notInstalled",
        "activationPending",
        "installed",
        "repairRequired"
      ]
    },
    "PluginLifecycleHintV1": {
      "type": "object",
      "properties": {
        "connectorInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "packageId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "packageId",
        "revision"
      ]
    },
    "PluginLinkV1": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ]
    },
    "PluginOperationKindV2": {
      "type": "string",
      "enum": [
        "install",
        "update"
      ]
    },
    "PluginOperationStageV2": {
      "type": "string",
      "enum": [
        "queued",
        "validating",
        "downloading",
        "extracting",
        "verifying",
        "publishing",
        "activating",
        "reconciling",
        "completed"
      ]
    },
    "PluginOperationStateV2": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "PluginOperationV2": {
      "type": "object",
      "properties": {
        "bytesCompleted": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "bytesTotal": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "canCancel": {
          "type": "boolean"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginError"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/PluginOperationKindV2"
        },
        "operationId": {
          "type": "string"
        },
        "packageId": {
          "$ref": "#/$defs/PluginPackageIdV2"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stage": {
          "$ref": "#/$defs/PluginOperationStageV2"
        },
        "startedAtMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/PluginOperationStateV2"
        },
        "updatedAtMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operationId",
        "packageId",
        "kind",
        "state",
        "stage",
        "revision",
        "cancelRequested",
        "canCancel",
        "startedAtMs",
        "updatedAtMs"
      ]
    },
    "PluginPackageIdV2": {
      "type": "string",
      "enum": [
        "dlubal-rfem",
        "rhino"
      ]
    },
    "PluginPresentationV1": {
      "type": "object",
      "properties": {
        "iconKey": {
          "$ref": "#/$defs/PluginIconV1"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginLinkV1"
          }
        },
        "overview": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "iconKey",
        "summary",
        "overview",
        "links"
      ]
    },
    "PluginProcessStateV1": {
      "type": "string",
      "enum": [
        "stopped",
        "starting",
        "running",
        "stopping",
        "failed"
      ]
    },
    "PluginSoftwareStateV1": {
      "type": "string",
      "enum": [
        "notDetected",
        "compatible",
        "unsupported"
      ]
    },
    "PluginViewV1": {
      "type": "object",
      "properties": {
        "connectorInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "$ref": "#/$defs/PluginDetailV1"
        },
        "displayName": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginError"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "packageId": {
          "type": "string"
        },
        "pluginVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "presentation": {
          "$ref": "#/$defs/PluginPresentationV1"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
