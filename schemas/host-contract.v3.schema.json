    "ReleaseManifestV1": {
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterV1"
        },
        "agentContract": {
          "$ref": "#/$defs/ContractRange"
        },
        "artifactVariantId": {
          "type": "string"
        },
        "components": {
