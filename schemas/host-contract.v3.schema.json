{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostContractV3",
  "description": "Aggregate used only to export the authoritative generic Host contract.",
  "type": "object",
  "properties": {
    "available_skill_package": { "$ref": "#/$defs/AvailableSkillPackageView" },
    "confirm_local_package_request": {
      "$ref": "#/$defs/ConfirmLocalPackageRequestV1"
    },
    "connect_plugin_request": { "$ref": "#/$defs/ConnectPluginRequestV1" },
    "delete_secret_request": { "$ref": "#/$defs/DeletePluginSecretRequestV1" },
    "enabled_request": { "$ref": "#/$defs/SetPluginEnabledRequestV1" },
    "install_request": { "$ref": "#/$defs/InstallPluginRequestV3" },
    "lifecycle_hint": { "$ref": "#/$defs/PluginLifecycleHintV2" },
    "list_plugin_skills_request": {
      "$ref": "#/$defs/ListPluginSkillsRequestV1"
    },
    "local_candidate": { "$ref": "#/$defs/LocalCandidateView" },
    "local_candidate_request": { "$ref": "#/$defs/LocalCandidateRequestV1" },
    "local_commit_result": { "$ref": "#/$defs/LocalCommitResult" },
    "local_package": { "$ref": "#/$defs/LocalPackageView" },
    "local_package_revision_request": {
      "$ref": "#/$defs/LocalPackageRevisionRequestV1"
    },
    "local_preview_request": { "$ref": "#/$defs/LocalPreviewRequestV1" },
    "local_uninstall_result": { "$ref": "#/$defs/LocalUninstallResult" },
    "native_extension": { "$ref": "#/$defs/NativeExtensionV1" },
    "open_plugin_link_request": { "$ref": "#/$defs/OpenPluginLinkRequestV1" },
    "operation": { "$ref": "#/$defs/PluginOperationV3" },
    "package_skill_reference": { "$ref": "#/$defs/PackageSkillReferenceV1" },
    "pick_local_package_request": {
      "$ref": "#/$defs/PickLocalPackageRequestV1"
    },
    "plugin": { "$ref": "#/$defs/PluginViewV3" },
    "plugin_asset_data": { "$ref": "#/$defs/PluginAssetDataV1" },
    "plugin_configuration": { "$ref": "#/$defs/PluginConfigurationV1" },
    "plugin_skill_preview": { "$ref": "#/$defs/PluginSkillPreviewV1" },
    "plugin_skills": { "$ref": "#/$defs/PluginSkillsV1" },
    "preview_available_skill_request": {
      "$ref": "#/$defs/PreviewAvailableSkillRequestV1"
    },
    "purge_request": { "$ref": "#/$defs/PurgePluginRequestV1" },
    "read_plugin_asset_request": { "$ref": "#/$defs/ReadPluginAssetRequestV1" },
    "read_plugin_skill_request": { "$ref": "#/$defs/ReadPluginSkillRequestV1" },
    "reconcile_local_confirmation_request": {
      "$ref": "#/$defs/ReconcileLocalConfirmationRequestV1"
    },
    "retry_request": { "$ref": "#/$defs/RetryPluginRequestV2" },
    "set_plugin_configuration_request": {
      "$ref": "#/$defs/SetPluginConfigurationRequestV1"
    },
    "set_secret_request": { "$ref": "#/$defs/SetPluginSecretRequestV1" },
    "signed_marketplace": { "$ref": "#/$defs/SignedMarketplaceV1" },
    "signed_skill_release": { "$ref": "#/$defs/SignedSkillReleaseV1" },
    "skill_enabled_request": {
      "$ref": "#/$defs/SetPluginSkillEnabledRequestV1"
    },
    "standard_manifest": { "$ref": "#/$defs/AgentPluginsManifestV1" },
    "uninstall_request": { "$ref": "#/$defs/UninstallPluginRequestV2" },
    "update_request": { "$ref": "#/$defs/UpdatePluginRequestV1" }
  },
  "required": [
    "package_skill_reference",
    "signed_skill_release",
    "available_skill_package",
    "preview_available_skill_request",
    "local_candidate",
    "local_package",
    "local_commit_result",
    "local_uninstall_result",
    "local_package_revision_request",
    "pick_local_package_request",
    "local_candidate_request",
    "local_preview_request",
    "confirm_local_package_request",
    "reconcile_local_confirmation_request",
    "read_plugin_asset_request",
    "plugin_asset_data",
    "open_plugin_link_request",
    "standard_manifest",
    "native_extension",
    "plugin_configuration",
    "plugin",
    "connect_plugin_request",
    "set_plugin_configuration_request",
    "signed_marketplace",
    "install_request",
    "enabled_request",
    "skill_enabled_request",
    "list_plugin_skills_request",
    "read_plugin_skill_request",
    "plugin_skills",
    "plugin_skill_preview",
    "set_secret_request",
    "delete_secret_request",
    "update_request",
    "uninstall_request",
    "purge_request",
    "retry_request",
    "operation",
    "lifecycle_hint"
  ],
  "$defs": {
    "AdapterV1": {
      "type": "object",
      "properties": {
        "distribution": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["distribution", "version"]
    },
    "AgentPluginsManifestV1": {
      "$id": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Agent Plugins Manifest",
      "description": "Machine-readable schema for plugin.json in Agent Plugins 1.0.0. The Agent Plugins specification defines additional semantic and operational requirements.",
      "type": "object",
      "properties": {
        "$schema": {
          "description": "Canonical identifier of the plugin manifest schema for the Agent Plugins version targeted by this document.",
          "const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
        },
        "author": {
          "type": "object",
          "properties": {
            "email": { "type": "string" },
            "name": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" },
        "extensions": {
          "description": "Client-specific manifest data keyed by reverse-domain extension namespace. Agent Plugins assigns no semantics to namespace object contents.",
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "homepage": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "name": {
          "description": "Human-readable plugin name.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "repository": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["$schema", "name"]
    },
    "ArchiveV1": {
      "type": "object",
      "properties": {
        "byteLength": { "type": "integer", "format": "uint64", "minimum": 0 },
        "sha256": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["url", "byteLength", "sha256"]
    },
    "AvailableSkillPackageView": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "digest": { "type": "string" },
        "installable": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "name": { "type": "string" },
        "packageId": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocalSkillView" }
        },
        "version": { "type": "string" }
      },
      "additionalProperties": false,
      "required": [
        "packageId",
        "name",
        "description",
        "version",
        "digest",
        "installed",
        "installable",
        "skills"
      ]
    },
    "ComponentV1": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["kind", "id"]
    },
    "ConfirmLocalPackageRequestV1": {
      "type": "object",
      "properties": {
        "digest": { "type": "string" },
        "expectedRevision": {
          "type": ["integer", "null"],
          "format": "uint64",
          "minimum": 0
        },
        "token": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false,
      "required": ["token", "digest"]
    },
    "ConnectPluginRequestV1": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "packageId": { "type": "string" },
        "requestId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false,
      "required": ["packageId", "expectedRevision", "requestId"]
    },
    "ConnectionReasonV1": {
      "type": "string",
      "enum": [
        "none",
        "softwareNotRunning",
        "credentialMissing",
        "credentialInvalid",
        "nativeComponentUnavailable",
        "unsupportedVersion",
        "trustFailure",
        "softwareStarting",
        "transportUnavailable",
        "softwareBusy",
        "timeout",
        "unknown"
      ]
    },
    "ConnectionRetryDispositionV1": {
      "type": "string",
      "enum": ["none", "automatic", "userAction"]
    },
    "ContractRange": {
      "type": "object",
      "properties": {
        "max": { "type": "integer", "format": "uint32", "minimum": 0 },
        "min": { "type": "integer", "format": "uint32", "minimum": 0 }
      },
      "additionalProperties": false,
      "required": ["min", "max"]
    },
    "DeletePluginSecretRequestV1": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "fieldId": { "type": "string" },
        "packageId": { "type": "string" },
        "requestId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false,
      "required": ["packageId", "expectedRevision", "requestId", "fieldId"]
    },
    "InstallPluginRequestV3": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "packageId": { "type": "string" },
        "requestId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false,
      "required": ["packageId", "expectedRevision", "requestId"]
    },
    "ListPluginSkillsRequestV1": {
      "type": "object",
      "properties": { "packageId": { "type": "string" } },
      "additionalProperties": false,
      "required": ["packageId"]
    },
    "LocalCandidateRequestV1": {
      "type": "object",
      "properties": { "token": { "type": "string", "format": "uuid" } },
      "additionalProperties": false,
      "required": ["token"]
    },
    "LocalCandidateView": {
      "type": "object",
      "properties": {
        "digest": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocalSkillView" }
        },
        "token": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["token", "digest", "skills"]
    },
    "LocalCommitResult": {
      "type": "object",
      "properties": {
        "package": { "$ref": "#/$defs/LocalPackageView" },
        "synced": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["package", "synced"]
    },
    "LocalPackageRevisionRequestV1": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "packageId": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["packageId", "expectedRevision"]
    },
    "LocalPackageView": {
      "type": "object",
      "properties": {
        "digest": { "type": "string" },
        "enabled": { "type": "boolean" },
        "packageId": { "type": "string" },
        "revision": { "type": "integer", "format": "uint64", "minimum": 0 },
        "revoked": { "type": "boolean" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocalSkillView" }
        },
        "source": { "type": "string" },
        "uninstallPending": { "type": "boolean" },
        "version": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "required": [
        "packageId",
        "revision",
        "digest",
        "enabled",
        "uninstallPending",
        "revoked",
        "source",
        "skills"
      ]
    },
    "LocalPreviewRequestV1": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "token": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false,
      "required": ["token", "skillId"]
    },
    "LocalSkillView": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "skillId": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["skillId", "name", "description", "enabled"]
    },
    "LocalUninstallResult": {
      "type": "object",
      "properties": {
        "package": {
          "anyOf": [{ "$ref": "#/$defs/LocalPackageView" }, { "type": "null" }]
        },
        "removed": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["removed"]
    },
    "McpTransportV1": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "transport": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["transport", "path"]
    },
    "NativeExtensionV1": {
      "description": "Host extension, never an Agent Plugins standard root field.",
      "type": "object",
      "properties": {
        "adapter": { "$ref": "#/$defs/AdapterV1" },
        "agentContract": { "$ref": "#/$defs/ContractRange" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentV1" }
        },
        "configurationSchemaPath": { "type": "string" },
        "configurationSchemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "entrypoint": { "type": "string" },
        "hostContract": { "$ref": "#/$defs/ContractRange" },
        "mcp": { "$ref": "#/$defs/McpTransportV1" },
        "module": { "type": "string" },
        "native": {
          "anyOf": [{ "$ref": "#/$defs/NativePackageV1" }, { "type": "null" }]
        },
        "platform": { "$ref": "#/$defs/PlatformV1" },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        },
        "routine": { "$ref": "#/$defs/NativeRoutineV1" },
        "secretSlots": {
          "type": "array",
          "items": { "$ref": "#/$defs/SecretSlotV1" }
        },
        "software": { "$ref": "#/$defs/SoftwareRequirementV1" },
        "startupEnvelopeVersion": {
          "type": "integer",
          "format": "uint32",
          "maximum": 3,
          "minimum": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "platform",
        "hostContract",
        "agentContract",
        "startupEnvelopeVersion",
        "routine",
        "entrypoint",
        "module",
        "components",
        "mcp",
        "software",
        "adapter",
        "configurationSchemaVersion",
        "configurationSchemaPath",
        "secretSlots"
      ]
    },
    "NativePackageV1": {
      "type": "object",
      "properties": {
        "capabilityDigest": { "type": ["string", "null"] },
        "contractDigest": { "type": "string" },
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "packageId": { "type": "string" },
        "pluginId": { "type": "string", "format": "uuid" },
        "relativePath": { "type": "string" },
        "sha256": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "relativePath",
        "sha256",
        "contractVersion",
        "contractDigest",
        "pluginId"
      ]
    },
    "NativeRoutineKindV1": {
      "type": "string",
      "enum": ["managed-connector", "rhino-yak-bridge"]
    },
    "NativeRoutineV1": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/NativeRoutineKindV1" },
        "version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": ["kind", "version"]
    },
    "OpenPluginLinkRequestV1": {
      "type": "object",
      "properties": {
        "linkRole": { "type": "string" },
        "packageId": { "type": "string" },
        "presentationDigest": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["packageId", "presentationDigest", "linkRole"]
    },
    "PackageSkillReferenceV1": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "digest": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["id", "name", "description", "digest"]
    },
    "PickLocalPackageRequestV1": {
      "type": "object",
      "properties": { "targetPackageId": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "PlatformV1": {
      "type": "object",
      "properties": {
        "architecture": { "type": "string" },
        "os": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["os", "architecture"]
    },
    "PluginAssetDataV1": {
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "dataUri": { "type": "string" },
        "packageId": { "type": "string" },
        "presentationDigest": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["packageId", "presentationDigest", "assetId", "dataUri"]
    },
    "PluginAssetV1": {
      "type": "object",
      "properties": {
        "assetId": { "type": "string" },
        "mimeType": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["assetId", "sha256", "mimeType"]
    },
    "PluginConfigurationV1": {
      "description": "Ordinary values are accepted only after validation against the derived schema.",
      "type": "object",
      "properties": {
        "configurationSchema": true,
        "effectiveResourceRevision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "ordinarySchema": true,
        "packageId": { "type": "string" },
        "pendingApply": { "type": "boolean" },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secretSlots": {
          "type": "array",
          "items": { "$ref": "#/$defs/SecretSlotStatusV1" }
        },
        "values": true
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packageId",
        "revision",
        "effectiveResourceRevision",
        "pendingApply",
        "configurationSchema",
        "ordinarySchema",
        "values",
        "secretSlots"
      ]
    },
    "PluginError": {
      "type": "string",
      "enum": [
        "revisionConflict",
        "missingSecret",
        "secretStoreUnavailable",
        "secretStateUnknown",
        "invalidContract",
        "untrustedRelease",
        "releaseExpired",
        "releaseRevoked",
        "downgradeRejected",
        "artifactMismatch",
        "unsafeArchive",
        "tampered",
        "storageUnavailable",
        "downloadFailed",
        "downloadRejected",
        "operationCancelled",
        "operationInterrupted",
        "hostAlreadyRunning",
        "connectorStartFailed",
        "connectorExited",
        "portInUse",
        "pluginBusy",
        "agentUnavailable",
        "attachmentRejected",
        "catalogUnavailable",
        "unsupportedOperation",
        "unsupportedRhinoVersion",
        "yakUnavailable",
        "nativePackageFailed",
        "bridgeRejected",
        "bridgeIncompatible",
        "toolCatalogMismatch",
        "resultUnknown"
      ]
    },
    "PluginInstallationStateV1": {
      "type": "string",
      "enum": [
        "notInstalled",
        "activationPending",
        "installed",
        "repairRequired"
      ]
    },
    "PluginInterfaceV1": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/PluginAssetV1" }
        },
        "brandColor": { "type": ["string", "null"] },
        "brandColorDark": { "type": ["string", "null"] },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "links": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "longDescription": { "type": ["string", "null"] },
        "presentationDigest": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["presentationDigest", "capabilities", "links", "assets"]
    },
    "PluginLifecycleHintV2": {
      "type": "object",
      "properties": {
        "operationId": { "type": ["string", "null"] },
        "packageId": { "type": "string" },
        "revision": { "type": "integer", "format": "uint64", "minimum": 0 }
      },
      "additionalProperties": false,
      "required": ["packageId", "revision"]
    },
    "PluginOperationKindV2": {
      "type": "string",
      "enum": ["install", "update", "uninstall", "purge"]
    },
    "PluginOperationStageV2": {
      "type": "string",
      "enum": [
        "queued",
        "validating",
        "downloading",
        "extracting",
        "verifying",
        "publishing",
        "activating",
        "reconciling",
        "removing",
        "purging",
        "completed"
      ]
    },
    "PluginOperationStateV2": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
    },
    "PluginOperationV3": {
      "type": "object",
      "properties": {
        "bytesCompleted": {
          "type": ["integer", "null"],
          "format": "uint64",
          "minimum": 0
        },
        "bytesTotal": {
          "type": ["integer", "null"],
          "format": "uint64",
          "minimum": 0
        },
        "canCancel": { "type": "boolean" },
        "cancelRequested": { "type": "boolean" },
        "error": {
          "anyOf": [{ "$ref": "#/$defs/PluginError" }, { "type": "null" }]
        },
        "kind": { "$ref": "#/$defs/PluginOperationKindV2" },
        "operationId": { "type": "string" },
        "packageId": { "type": "string" },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint32",
          "maximum": 3,
          "minimum": 3
        },
        "stage": { "$ref": "#/$defs/PluginOperationStageV2" },
        "startedAtMs": { "type": "integer", "format": "uint64", "minimum": 0 },
        "state": { "$ref": "#/$defs/PluginOperationStateV2" },
        "updatedAtMs": { "type": "integer", "format": "uint64", "minimum": 0 }
      },
      "additionalProperties": false,
