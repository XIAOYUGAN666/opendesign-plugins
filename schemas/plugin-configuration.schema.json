{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginConfigurationV1",
  "description": "Ordinary values are accepted only after validation against the derived schema.",
  "type": "object",
  "properties": {
    "configurationSchema": true,
    "effectiveResourceRevision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "ordinarySchema": true,
    "packageId": { "type": "string" },
    "pendingApply": { "type": "boolean" },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "schemaVersion": { "type": "integer", "format": "uint32", "minimum": 0 },
    "secretSlots": {
      "type": "array",
      "items": { "$ref": "#/$defs/SecretSlotStatusV1" }
    },
    "values": true
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "revision",
    "effectiveResourceRevision",
    "pendingApply",
    "configurationSchema",
    "ordinarySchema",
    "values",
    "secretSlots"
  ],
  "$defs": {
    "SecretSlotStatusV1": {
      "description": "Safe credential presence only. Secret values and software connection state stay separate.",
      "type": "object",
      "properties": {
        "componentId": { "type": "string" },
        "configured": { "type": "boolean" },
        "fieldId": { "type": "string" },
        "requiredForEngineering": { "type": "boolean" },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fieldId",
        "componentId",
        "requiredForEngineering",
        "configured",
        "revision"
      ]
    }
  }
}
