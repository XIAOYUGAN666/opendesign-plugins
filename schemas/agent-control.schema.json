{
  "$defs": {
    "ConnectorDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "artifactVariantId": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        "bearerToken": {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        "connectorBuildId": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "connectorInstanceId": {
          "pattern": "^ci_[0-9a-f]{32}$",
          "type": "string"
        },
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "packageId": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "pluginVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "toolCatalogDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "connectorInstanceId",
        "packageId",
        "pluginVersion",
        "artifactVariantId",
        "connectorBuildId",
        "generation",
        "url",
        "bearerToken",
        "toolCatalogDigest"
      ],
      "title": "ConnectorDescriptorV1",
      "type": "object"
    },
    "ConnectorDescriptorV2": {
