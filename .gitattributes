# Fixed owner exports: preserve exact bytes on every checkout.
/schemas/host-native.schema.json -text
/schemas/agent-control.schema.json -text
/schemas/host-contract.v3.schema.json -text
/schemas/plugin-configuration.schema.json -text
/schemas/bridge-control-v2.schema.json -text
/schemas/agent-plugins-1.0.0.schema.json -text
# Generated approved views and market bytes must survive checkout unchanged.
/published/** -text
# Signed projections preserve artifact line endings, including repeated CR bytes.
/published/** whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
/.agents/plugins/marketplace.json -text
/.agents/plugins/marketplace.snapshot.json -text
# Frozen Rhino build inputs retain their verified source bytes across checkouts.
/plugins/rhino/provider/** -text whitespace=cr-at-eol
/plugins/rhino/native/** -text whitespace=cr-at-eol
/plugins/rhino/contracts/** -text whitespace=cr-at-eol
/plugins/rhino/global.json -text whitespace=cr-at-eol
# Preserve migrated reference text and tool docstrings, including schema descriptions.
/plugins/rhino/provider/rhino_mcp/static/source/** whitespace=cr-at-eol,-blank-at-eol
/plugins/rhino/provider/rhino_mcp/tools/** whitespace=cr-at-eol,-blank-at-eol
/plugins/rhino/provider/rhino_mcp/static/source/group.py whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Root manifest digests bind exact approved/generated bytes, not checkout-normalized text.
/plugins/*/plugin.json -text whitespace=cr-at-eol
/schemas/host-publisher-policy.json -text
/schemas/host-publisher-policy.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
