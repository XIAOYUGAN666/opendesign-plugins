{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "fixture-engineering",
  "version": "0.1.0",
  "description": "Internal synthetic MCP workflow fixture; never a Stable engineering plugin.",
  "author": {
    "name": "OpenDesign team"
  },
  "extensions": {
    "io.github.xiaoyugan666.native": {
      "platform": {
        "os": "windows",
        "architecture": "x86_64"
      },
      "hostContract": {
        "min": 1,
        "max": 1
      },
      "agentContract": {
        "min": 1,
        "max": 1
      },
      "entrypoint": "runtime/python/python.exe",
      "module": "fixture_engineering.managed_bootstrap",
      "components": [
        {
          "kind": "provider",
          "id": "fixture-engineering"
        }
      ],
      "mcp": {
        "transport": "streamable-http",
        "path": "/mcp"
      },
      "software": {
        "product": "fixture-engineering",
        "major": 1,
        "supportedBuilds": [
          "synthetic-1"
        ]
      },
      "adapter": {
        "distribution": "fixture-engineering",
        "version": "0.1.0"
      },
      "configurationSchemaVersion": 1,
      "protocolVersion": 1,
      "startupEnvelopeVersion": 2,
      "routine": {
        "kind": "managed-provider",
        "version": 1
      },
      "configurationSchemaPath": "configuration.schema.json",
      "secretSlots": []
    }
  }
}
