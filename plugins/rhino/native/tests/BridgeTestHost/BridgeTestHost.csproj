<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="RhinoCommon"
      Version="8.17.25066.7001"
      GeneratePathProperty="true"
      ExcludeAssets="runtime"
    />
    <PackageReference
      Include="Grasshopper"
      Version="8.17.25066.7001"
      GeneratePathProperty="true"
      ExcludeAssets="runtime"
    />
    <ProjectReference Include="..\..\RhinoMcpBridge.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(PkgRhinoCommon)\lib\net48\RhinoCommon.dll"
      Link="RhinoCommon.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="$(PkgGrasshopper)\lib\net48\Grasshopper.dll"
      Link="Grasshopper.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="$(PkgGrasshopper)\lib\net48\GH_IO.dll"
      Link="GH_IO.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
