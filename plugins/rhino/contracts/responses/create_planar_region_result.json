{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "create_planar_region_result.json",
  "title": "Created planar geometry receipt",
  "type": "object",
  "properties": {
    "success": { "const": true },
    "id": { "$ref": "../common/definitions.json#/$defs/guid" },
    "face_count": { "const": 1 },
    "loop_count": { "type": "integer", "minimum": 1 },
    "outer_loop_count": { "const": 1 },
    "inner_loop_count": { "type": "integer", "minimum": 0 },
    "message": { "type": "string" }
  },
  "required": ["success", "id", "face_count", "loop_count", "outer_loop_count", "inner_loop_count", "message"],
  "additionalProperties": false
}
