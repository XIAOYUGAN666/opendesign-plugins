{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rhino",
  "version": "0.1.21",
  "description": "Rhino 8 local engineering tools and workflow skills.",
  "author": {
    "name": "OpenDesign team"
  },
  "extensions": {
    "ai.opendesign.desktop": {
      "setup": {"command": "runtime/python/python.exe", "args": ["-m", "rhino_mcp.setup"], "diagnostics": true}
    },
    "io.github.xiaoyugan666.native": {
      "platform": {
        "os": "windows",
        "architecture": "x86_64"
      },
      "hostContract": {
        "min": 1,
        "max": 1
      },
      "agentContract": {
        "min": 1,
        "max": 1
      },
      "entrypoint": "runtime/python/python.exe",
      "module": "rhino_mcp.managed_bootstrap",
      "components": [
        {
          "kind": "connector",
          "id": "rhino"
        },
        {
          "kind": "native",
          "id": "rhino-mcp-bridge"
        }
      ],
      "mcp": {
        "transport": "streamable-http",
        "path": "/mcp"
      },
      "software": {
        "product": "rhino",
        "major": 8,
        "supportedBuilds": [
          "8.26.25349.19001"
        ]
      },
      "adapter": {
        "distribution": "rhino-common",
        "version": "8.17.0"
      },
      "configurationSchemaVersion": 1,
      "protocolVersion": 1,
      "startupEnvelopeVersion": 3,
      "routine": {
        "kind": "rhino-yak-bridge",
        "version": 1
      },
      "configurationSchemaPath": "configuration.schema.json",
      "secretSlots": [],
      "native": {
        "capabilityDigest": "sha256:65646f8bf0460e8919b6d0b8af938efd3560ab07b376760184ac6e4c792f63bb",
        "contractDigest": "sha256:c83bb3c857a6c8d65863ae6e58da3f1ec6c16aedaa65f62e2a42cc4a164f3c1c",
        "contractVersion": 1,
        "packageId": "rhino-mcp-bridge",
        "pluginId": "74a1e8f4-1134-4686-a3e5-ee8bf393dec9",
        "relativePath": "native/rhino-mcp-bridge-0.1.21-rh8-win.yak",
        "sha256": "sha256:b3e631ca40171c232ea1cbac23437277e4bf97673ab48ac16ee5add2509a1757",
        "version": "0.1.21"
      }
    },
    "com.openai": {
      "interface": {
        "displayName": "Rhino",
        "shortDescription": "Rhino 8 geometry and Grasshopper tools.",
        "longDescription": "Connect Rhino 8 and Grasshopper through a managed connector and native Bridge. Includes workflow skills; engineering operations follow the existing permissions and approval flow.",
        "developerName": "OpenDesign team",
        "category": "Engineering Design",
        "capabilities": [
          "Rhino",
          "Grasshopper"
        ],
        "websiteURL": "https://www.rhino3d.com/",
        "supportURL": "https://github.com/XIAOYUGAN666/opendesign-plugins/issues",
        "brandColor": "#CC0000",
        "composerIcon": "./assets/rhino.svg",
        "logo": "./assets/rhino.png"
      }
    }
  }
}
