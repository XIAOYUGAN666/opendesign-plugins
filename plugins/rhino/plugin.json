{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rhino",
  "version": "0.1.19",
  "description": "Rhino 8 local engineering tools and workflow skills.",
  "author": {
    "name": "OpenDesign team"
  },
  "extensions": {
    "io.github.xiaoyugan666.native": {
      "platform": {
        "os": "windows",
        "architecture": "x86_64"
      },
      "hostContract": {
        "min": 1,
        "max": 1
      },
      "agentContract": {
        "min": 1,
        "max": 1
      },
      "entrypoint": "runtime/python/python.exe",
      "module": "rhino_mcp.managed_bootstrap",
      "components": [
        {
          "kind": "connector",
          "id": "rhino"
        },
        {
          "kind": "native",
          "id": "rhino-mcp-bridge"
        }
      ],
      "mcp": {
        "transport": "streamable-http",
        "path": "/mcp"
      },
      "software": {
        "product": "rhino",
        "major": 8,
        "supportedBuilds": [
          "8.26.25349.19001"
        ]
      },
      "adapter": {
        "distribution": "rhino-common",
        "version": "8.17.0"
      },
      "configurationSchemaVersion": 1,
      "protocolVersion": 1,
      "startupEnvelopeVersion": 3,
      "routine": {
        "kind": "rhino-yak-bridge",
        "version": 1
      },
      "configurationSchemaPath": "configuration.schema.json",
      "secretSlots": [],
      "native": {
        "capabilityDigest": "sha256:31deb833e6191571e9e05103f5af047347d685a020d129ed983b1a365b8dfab6",
        "contractDigest": "sha256:3deffd5de2f9f7b44a968b63aaad67334cdf7a1f6c9a6bc847b914d8b615c9a9",
        "contractVersion": 1,
        "packageId": "rhino-mcp-bridge",
        "pluginId": "74a1e8f4-1134-4686-a3e5-ee8bf393dec9",
        "relativePath": "native/rhino-mcp-bridge-0.1.19-rh8-win.yak",
        "sha256": "sha256:2f8cc868bf7e60ae3ac3b25b6ef287f7a20542da6d1b702075e35954ce744360",
        "version": "0.1.19"
      }
    },
    "com.openai": {
      "interface": {
        "displayName": "Rhino",
        "shortDescription": "Rhino 8 geometry and Grasshopper tools.",
        "longDescription": "Connect Rhino 8 and Grasshopper through a managed connector and native Bridge. Includes workflow skills; engineering operations follow the existing permissions and approval flow.",
        "developerName": "OpenDesign team",
        "category": "Engineering Design",
        "capabilities": [
          "Rhino",
          "Grasshopper"
        ],
        "websiteURL": "https://www.rhino3d.com/",
        "supportURL": "https://github.com/XIAOYUGAN666/opendesign-plugins/issues",
        "brandColor": "#CC0000",
        "composerIcon": "./assets/rhino.svg",
        "logo": "./assets/rhino.png"
      }
    }
  }
}
