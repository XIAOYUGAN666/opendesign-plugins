{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dlubal-rfem",
  "version": "0.2.4",
  "description": "Local RFEM 6 structural modeling, calculation and results tools.",
  "author": {
    "name": "OpenDesign team"
  },
  "extensions": {
    "ai.opendesign.desktop": {
      "agents": {
        "schemaVersion": 1,
        "files": ["agents/rfem-analyst.md"]
      },
      "setup": {
        "command": "runtime/python/python.exe",
        "args": [
          "-m",
          "dlubal_mcp.setup"
        ],
        "diagnostics": true,
        "credentialSlots": {
          "diagnose": "dlubal-api-key"
        }
      },
      "credentialEnvironment": {
        "rfem": {
          "PLUGIN_RFEM_API_KEY": "dlubal-api-key"
        }
      }
    },
    "io.github.xiaoyugan666.native": {
      "platform": {
        "os": "windows",
        "architecture": "x86_64"
      },
      "hostContract": {
        "min": 1,
        "max": 1
      },
      "agentContract": {
        "min": 1,
        "max": 1
      },
      "entrypoint": "runtime/python/python.exe",
      "module": "dlubal_mcp.plugin_stdio",
      "components": [
        {
          "kind": "connector",
          "id": "dlubal-rfem"
        }
      ],
      "mcp": {
        "transport": "stdio",
        "path": ""
      },
      "software": {
        "product": "dlubal-rfem",
        "major": 6,
        "supportedBuilds": []
      },
      "adapter": {
        "distribution": "dlubal.api",
        "version": "prepared-at-installation"
      },
      "configurationSchemaVersion": 1,
      "protocolVersion": 1,
      "startupEnvelopeVersion": 3,
      "routine": {
        "kind": "managed-connector",
        "version": 1
      },
      "configurationSchemaPath": "configuration.schema.json",
      "secretSlots": [
        {
          "fieldId": "dlubal-api-key",
          "componentId": "dlubal-rfem"
        }
      ]
    },
    "com.openai": {
      "interface": {
        "displayName": "Dlubal RFEM",
        "shortDescription": "RFEM 6 structural modeling, calculation and results tools.",
        "longDescription": "Connect to local RFEM 6 for structural modeling, calculation and results. Delegate RFEM work to rfem-analyst or select it in chat. Use the plugin settings for the RFEM API connection and the connector's tool preferences for approval.",
        "developerName": "OpenDesign team",
        "category": "Engineering Design",
        "capabilities": [
          "Structural modeling",
          "Calculation",
          "Results"
        ],
        "websiteURL": "https://www.dlubal.com/en",
        "supportURL": "https://github.com/XIAOYUGAN666/opendesign-plugins/issues",
        "brandColor": "#FFC000",
        "composerIcon": "./assets/rfem.svg",
        "logo": "./assets/rfem.svg"
      }
    }
  }
}
